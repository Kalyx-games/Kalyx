{
  "rewrites": [
    {
      "source": "/api/sb/:path*",
      "destination": "/api/sbproxy?p=:path*"
    }
  ],
  "images": {
    "sizes": [
      128,
      200,
      256,
      384,
      640
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 31536000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "cf.geekdo-images.com"
      },
      {
        "protocol": "https",
        "hostname": "philibertnet.com"
      },
      {
        "protocol": "https",
        "hostname": "**.philibertnet.com"
      },
      {
        "protocol": "https",
        "hostname": "**.cultura.com"
      },
      {
        "protocol": "https",
        "hostname": "i0.wp.com"
      },
      {
        "protocol": "https",
        "hostname": "upload.wikimedia.org"
      },
      {
        "protocol": "https",
        "hostname": "www.fetedujeu.org"
      },
      {
        "protocol": "https",
        "hostname": "static.fnac-static.com"
      }
    ]
  }
}
